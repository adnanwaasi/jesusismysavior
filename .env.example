# PostgreSQL service credentials for local Docker Compose only. Replace before any shared deployment.
POSTGRES_DB=invoice_auditor
POSTGRES_USER=invoice_auditor
POSTGRES_PASSWORD=change-me-for-local-use

# Monitor settings
MONITOR_POLL_INTERVAL_SECONDS=2
FILE_STABILITY_SECONDS=3
MAX_FILE_SIZE_BYTES=52428800
LOG_LEVEL=INFO

# Upload API settings
API_PORT=8000

# Phase 2 worker settings
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_SECONDS=2
MAX_PROCESSING_ATTEMPTS=3
STALE_JOB_TIMEOUT_SECONDS=300
OCR_LANGUAGES=eng
EXTRACTION_MAX_PAGES=25
PDF_MIN_MEANINGFUL_CHARACTERS=40
PDF_MIN_PRINTABLE_RATIO=0.8
OCR_DPI=200
